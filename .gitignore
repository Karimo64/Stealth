# This .gitignore is set up for a Unity project.
# It tells Git to ignore all the auto-generated / local-machine-only folders
# so your repository only contains the actual source of your game.

# Unity auto-generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Autogenerated VS/Rider/VSCode project files (recreated automatically)
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files that don't need tracking
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packages folder cache (Package Manager)
/[Pp]ackages/*.tmp
